# --- PAYSTACK KEYS ---
# Required for live payment processing.
# Add your Paystack Public Key here to allow frontend popups.
VITE_PAYSTACK_PUBLIC_KEY=
# Add your Paystack Secret Key here to allow backend transaction verification. Keep this secret!
PAYSTACK_SECRET_KEY=

# --- FIREBASE SECRETS ---
# Optional: Needed for the backend to securely update user subscriptions after payment.
# Use the unformatted JSON string downloaded from Firebase Console -> Project Settings -> Service Accounts.
FIREBASE_SERVICE_ACCOUNT_KEY=

# --- GEMINI API KEY (PRIMARY AI PROVIDER) ---
# Required for the Server-Side AI Assistant and all generative features of the platform.
# Get one free at https://aistudio.google.com/
GEMINI_API_KEY=
# Optional: override the default Gemini model (default: gemini-2.5-flash)
GEMINI_DEFAULT_MODEL=gemini-2.5-flash
# Optional: comma-separated list of allowed Gemini models (for admin UI validation)
GEMINI_AVAILABLE_MODELS=gemini-2.5-flash,gemini-2.5-flash-lite,gemini-2.5-pro,gemini-2.0-flash,gemini-1.5-flash,gemini-1.5-pro

# --- GROQ API KEY (FAST BACKUP AI PROVIDER) ---
# Optional but recommended. Free at https://console.groq.com/
# Used for fast chat, summarisation, and as a fallback when Gemini is rate-limited.
GROQ_API_KEY=
GROQ_DEFAULT_MODEL=llama-3.3-70b-versatile
GROQ_AVAILABLE_MODELS=llama-3.3-70b-versatile,llama-3.1-8b-instant,llama-3.1-70b-versatile,llama3-70b-8192,llama3-8b-8192,mixtral-8x7b-32768,gemma2-9b-it

# --- OPENROUTER API KEY (TERTIARY AI PROVIDER, FREE MODELS) ---
# Optional. Free at https://openrouter.ai/
# Provides access to 25+ free models (50 req/day on the free plan).
# Used as a third fallback and for experimentation.
OPENROUTER_API_KEY=
OPENROUTER_DEFAULT_MODEL=meta-llama/llama-3.3-70b-instruct:free
OPENROUTER_AVAILABLE_MODELS=meta-llama/llama-3.3-70b-instruct:free,meta-llama/llama-3.1-8b-instruct:free,google/gemini-2.0-flash-exp:free,mistralai/mistral-7b-instruct:free,qwen/qwen-2.5-7b-instruct:free,deepseek/deepseek-chat:free
# Optional: site URL for OpenRouter attribution
OPENROUTER_REFERER=https://stacfund.ai

# --- HUGGING FACE TOKEN (EMBEDDINGS-ONLY PROVIDER) ---
# Optional. Free at https://huggingface.co/settings/tokens
# Used only for embeddings (semantic search of funding opportunities).
HF_API_TOKEN=
HF_DEFAULT_MODEL=sentence-transformers/all-MiniLM-L6-v2
HF_AVAILABLE_MODELS=sentence-transformers/all-MiniLM-L6-v2,sentence-transformers/all-mpnet-base-v2,distilbert-base-uncased

# --- AI GATEWAY CONTROLS ---
# Master switch: enable paid AI providers/models (default: false — free-first).
# Set to "true" ONLY when you're ready to pay for AI usage. Even then, you must
# also add specific paid model IDs to STACFUND_AI_PAID_ALLOWLIST below.
STACFUND_ENABLE_PAID_AI=false
# Comma-separated list of paid model IDs that are allowed even when
# STACFUND_ENABLE_PAID_AI is false. Example: imagen-3.0-generate-001
STACFUND_AI_PAID_ALLOWLIST=
# Force-disable individual providers (rarely needed — useful if a provider
# is having a sustained outage and you want to skip it without removing the key).
STACFUND_AI_DISABLE_GEMINI=false
STACFUND_AI_DISABLE_GROQ=false
STACFUND_AI_DISABLE_OPENROUTER=false
STACFUND_AI_DISABLE_HUGGINGFACE=false

# --- ADMIN SECRET (FOR GATEWAY PROBE ENDPOINT) ---
# Optional but recommended. Required to call POST /api/ai/gateway/health/probe
# (which actively pings every provider). The admin UI panel passes this as
# the x-admin-secret header.
STACFUND_ADMIN_SECRET=

# --- LEGACY BYOK (DEPRECATED, NOT RECOMMENDED FOR PRODUCTION) ---
# If true, the server will accept the x-custom-gemini-key header on legacy
# requireAuth routes (so users can supply their own Gemini key). This was the
# pre-gateway behaviour and is now DISABLED BY DEFAULT for security.
# Leave this unset (or false) in production. All credentials should be server-side.
STACFUND_ALLOW_CUSTOM_GEMINI_KEY=false

# --- PRESENTON INTEGRATION ---
# URL for the Presenton presentation generator service
PRESENTON_URL=http://localhost:5000

# --- STOCK PHOTO FALLBACKS (OPTIONAL) ---
# Free at https://www.pexels.com/api/
PEXELS_API_KEY=
# Free at https://pixabay.com/api/docs/
PIXABAY_API_KEY=
