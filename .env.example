# --- PAYSTACK KEYS ---
# Required for live payment processing.
# Add your Paystack Public Key here to allow frontend popups.
VITE_PAYSTACK_PUBLIC_KEY=
# Add your Paystack Secret Key here to allow backend transaction verification. Keep this secret!
PAYSTACK_SECRET_KEY=

# --- FIREBASE SECRETS ---
# Optional: Needed for the backend to securely update user subscriptions after payment.
# Use the unformatted JSON string downloaded from Firebase Console -> Project Settings -> Service Accounts.
FIREBASE_SERVICE_ACCOUNT_KEY=

# --- GEMINI API KEY ---
# Required for the Server-Side AI Assistant and all generative features of the platform.
GEMINI_API_KEY=

# --- PRESENTON INTEGRATION ---
# URL for the Presenton presentation generator service
PRESENTON_URL=http://localhost:5000

# --- STOCK PHOTO FALLBACKS (OPTIONAL) ---
# Free at https://www.pexels.com/api/
PEXELS_API_KEY=
# Free at https://pixabay.com/api/docs/
PIXABAY_API_KEY=

# --- ADMIN / FUNDING INTAKE ---
# Who may use the funding intake and review queue. The server checks this on every request.
# Emails must be verified in Firebase Auth. If both lists are empty, nobody is an admin.
ADMIN_EMAILS=
# Alternative: Firebase user IDs (works even if the email is not verified)
ADMIN_UIDS=
# UI hint only: shows the "Add a Funding Opportunity" card on the dashboard for these emails.
# It does NOT grant access; ADMIN_EMAILS on the server does.
VITE_ADMIN_EMAILS=
# Secret for POST /api/scraper/run (send it in the x-admin-secret header, e.g. from Cloud Scheduler)
ADMIN_API_SECRET=
# Optional: override the Gemini model used to read posters, PDFs and pages
GEMINI_EXTRACTION_MODEL=

# --- ADMIN ALERTS (OPTIONAL, FREE) ---
# Create a bot with @BotFather on Telegram, message it once, then put its token and your chat id here.
# The scraper uses it to tell you when new funding drafts are waiting for review.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- USER ALERTS (OPTIONAL) ---
# When an admin publishes a new funding opportunity, every signed-in user
# whose profile matches the opportunity gets an alert. All channels are
# silent no-ops when their env vars are missing — only the in-app bell rings.
#
# Email — any SMTP provider. The "secure" flag is set when PORT=465.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
ALERT_FROM_EMAIL=

# WhatsApp — Twilio's WhatsApp Business API. Get these from the Twilio console.
# TWILIO_WHATSAPP_FROM must be your Twilio WhatsApp number in E.164, prefixed with "whatsapp:".
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=

# Push — Firebase Cloud Messaging legacy server key. Get it from
# Firebase Console → Project Settings → Cloud Messaging → Server Key.
# (If FIREBASE_SERVICE_ACCOUNT_KEY is set, FCM will use that instead —
# this is only for the legacy HTTP API.)
FCM_SERVER_KEY=

